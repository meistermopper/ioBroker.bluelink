{
    "type": "panel",
    "i18n": true,
    "items": {
        "header_Start": {
            "type": "header",
            "text": "bluelink adapter settings",
            "size": 2
        },
        "Account settings": {
            "type": "header",
            "text": "Account settings",
            "size": 2,
            "newLine": true
        },
        "brand": {
            "newLine": true,
            "type": "select",
            "label": "Brand",
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3,
            "options": [
                {
                    "label": "Kia",
                    "value": "kia"
                },
                {
                    "label": "Hyundai",
                    "value": "hyundai"
                }
            ]
        },
        "motor": {
            "type": "select",
            "label": "Motor",
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3,
            "options": [
                {
                    "label": "EV",
                    "value": "EV"
                },
                {
                    "label": "PHEV/MHEV",
                    "value": "HEV"
                },
                {
                    "label": "Diesel/Benzin",
                    "value": "GAS"
                }
            ]
        },
        "batteryRange": {
            "type": "number",
            "label": "max km Range",
            "help": "only for PHEV",
            "hidden": "data.motor === 'EV' || data.motor === 'GAS'",
            "unit": "km",
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "language": {
            "newLine": true,
            "type": "select",
            "label": "App Lang",
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3,
            "options": [
                {
                    "label": "DE",
                    "value": "de"
                },
                {
                    "label": "EN",
                    "value": "en"
                },
                {
                    "label": "NL",
                    "value": "nl"
                },
                {
                    "label": "IT",
                    "value": "it"
                },
                {
                    "label": "ES",
                    "value": "es"
                },
                {
                    "label": "PL",
                    "value": "pl"
                }
            ]
        },
        "username": {
            "type": "text",
            "label": "Username",
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "password": {
            "type": "password",
            "label": "Password",
            "repeat": false,
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "client_secret_pin": {
            "type": "password",
            "label": "Pin",
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "lastLoginDisplay": {
            "type": "text",
            "label": "Last successful login (auto-managed)",
            "disabled": "true",
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "client_secret": {
            "type": "text",
            "hidden": "true"
        },
        "header_Fallback": {
            "type": "header",
            "text": "Fallback",
            "size": 2,
            "newLine": true
        },
        "_fallbackHelp": {
            "type": "staticText",
            "text": "Automatic login (OneApp/CCI) only requires Username and Password above — leave Refresh Token empty on initial setup; the adapter fetches and renews the token automatically. Optional fallback: paste an evcc JSON token bundle (key bluelink-cci.<brand>.<user>) if you do not want to store your password.",
            "newLine": true
        },
        "refreshToken": {
            "type": "password",
            "label": "Refresh Token (auto-managed / optional evcc fallback)",
            "repeat": false,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 8,
            "lg": 6,
            "xl": 6
        },
        "_fallbackDocLink": {
            "type": "staticLink",
            "label": "Token-documentation",
            "button": true,
            "variant": "outlined",
            "color": "primary",
            "icon": "info",
            "href": "https://github.com/Newan/ioBroker.bluelink#authentication--initial-setup-eu-hyundai--kia",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "Api settings": {
            "type": "header",
            "text": "Api settings",
            "size": 2,
            "newLine": true
        },
        "request": {
            "type": "number",
            "label": "Request max 400",
            "min": 1,
            "max": 400,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 3,
            "xl": 3
        },
        "errorCounter": {
            "type": "number",
            "label": "errorCounter",
            "min": 1,
            "max": 50,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 3,
            "xl": 3
        },
        "evHistory": {
            "type": "checkbox",
            "label": "Receive Daily drive History (EV cars only, needs 3 request per day)",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "protectAgainstDeepDischarge": {
            "type": "checkbox",
            "label": "Stop refresh if 12V battery is under 10.5 V to protect against irreversible damage",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "resAddress": {
            "type": "checkbox",
            "label": "Resolve the address from coordinates using openstreetmap",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        }
    }
}
