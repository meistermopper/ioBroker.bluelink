// Specialized tsconfig for type-checking js files
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "skipLibCheck": true
    },
    "include": [
        "**/*.js",
        "**/*.d.ts"
    ],
    "exclude": [
        "**/build",
        "node_modules/**",
        "widgets/",
        "gulpfile.js",
        "*.test.js",
        "test/**"
    ]
}
